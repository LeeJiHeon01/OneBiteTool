# 이 파일을 복사해 .env 로 만들고 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# --- docker-compose (로컬 PostgreSQL, Docker를 쓸 때만) ---
POSTGRES_PORT=5432
POSTGRES_DB=cooking_helper
POSTGRES_USER=cooking_app
POSTGRES_PASSWORD=change-me

# --- Spring Boot 서버 ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cooking_helper
SPRING_DATASOURCE_USERNAME=cooking_app
SPRING_DATASOURCE_PASSWORD=change-me
OPENAI_API_KEY=
RECIPE_API_KEY=

# --- 앱 (apps/mobile/.env) ---
# EXPO_PUBLIC_API_BASE_URL=http://<PC의 같은 Wi-Fi IP>:8080
