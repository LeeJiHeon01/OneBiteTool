# Copy to .env and fill in real values. .env is never committed.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cooking_helper
# Separate database used by `gradlew test`
SPRING_DATASOURCE_TEST_URL=jdbc:postgresql://localhost:5432/cooking_helper_test
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# OpenAI (server only). Empty key = AI calls are skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_DAILY_CALL_LIMIT=100
# Makes the fixture recipes' adaptations at start-up for a demonstration (AI calls the first time)
APP_ADAPTATION_WARMUP_ENABLED=false
